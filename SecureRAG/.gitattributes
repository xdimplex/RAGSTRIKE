# Line ending normalization -- see the RAGStrike .gitattributes for the rationale.
#
# LF in the repository regardless of each developer's core.autocrlf setting. Matters here because
# both profiles must ingest a byte-identical corpus: a manifest checksum computed on a CRLF checkout
# would not match one computed on LF, and chunk provenance verification would fail for reasons that
# have nothing to do with security.

* text=auto eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.pdf  binary
*.ico  binary
*.db   binary
*.svg  text eol=lf

# Corpus documents are fixtures with declared checksums. No filtering.
# Scoped to the document files: a blanket `corpus/**` would also mark the manifest and the folder
# READMEs binary, and those must stay diffable -- reviewing a manifest change is how a corpus
# modification gets caught.
corpus/**/*.pdf -text -diff
corpus/**/*.txt -text -diff
