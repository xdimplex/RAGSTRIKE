# Line ending normalization.
#
# PURPOSE
#   Guarantee LF in the repository regardless of each developer's core.autocrlf setting.
#
# WHY IT EXISTS
#   .editorconfig declares LF, but it only governs editors -- git will still rewrite line endings on
#   checkout on Windows. NFR-02 states Linux, macOS, and Windows are all supported and all tested in
#   CI; without this file, a Windows contributor's first commit shows every line of every file as
#   changed, and CRLF creeps into YAML manifests and shell scripts where it breaks things.

* text=auto eol=lf

# Windows tooling expects CRLF for these.
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary -- never touch.
*.png  binary
*.jpg  binary
*.svg  text eol=lf
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.db   binary

# Golden fixtures: byte-stable comparison matters, so no filtering of any kind.
# Scoped to the fixture subdirectories -- a blanket `tests/sample_reports/**` also marks the
# directory's README binary, which makes documentation undiffable for no benefit.
tests/sample_reports/golden/**   -text -diff
tests/sample_payloads/**/*.yaml  -text
tests/fixtures/evidence_corpus/** -text -diff
