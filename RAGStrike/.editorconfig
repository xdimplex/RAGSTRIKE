# EditorConfig -- consistent whitespace across every editor, before any linter runs.
#
# PURPOSE
#   Stop the trailing-whitespace and line-ending churn that otherwise fills diffs on a mixed
#   Windows / macOS / Linux team.
#
# WHY IT EXISTS
#   black and ruff fix Python.  Nothing else fixes YAML, Markdown, SQL, or shell scripts.
#   Line endings are LF everywhere except .bat/.ps1, which Windows tooling expects as CRLF.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # two trailing spaces is a hard line break in Markdown
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.{bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
