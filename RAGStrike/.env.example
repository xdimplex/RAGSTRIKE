# --------------------------------------------------------------------------------------------------
# RAGStrike -- environment variable template
#
# PURPOSE
#   Documents every environment variable the framework reads.  Copy to `.env` and edit.
#
# WHY IT EXISTS
#   Environment variables are precedence level 5 of 6 (SDD 21.1): they override YAML configuration
#   but not explicit CLI flags or API request bodies.  Secrets live here and NOWHERE else -- never in
#   configs/*.yaml, never in code, never in a committed file.
#
#   `.env` is gitignored.  `.env.example` is committed and must never contain a real value.
#
# NAMING
#   RAGSTRIKE_<SECTION>__<KEY>, double underscore for nesting.
#   RAGSTRIKE_ENGINE__MAX_CONCURRENCY maps to engine.max_concurrency in configs/ragstrike.yaml.
# --------------------------------------------------------------------------------------------------

# ---- Runtime --------------------------------------------------------------------------------------
RAGSTRIKE_ENV=development                       # development | production
RAGSTRIKE_CONFIG_FILE=configs/ragstrike.yaml

# ---- Storage --------------------------------------------------------------------------------------
# Contains RAW, UNREDACTED evidence.  Keep it local; never sync it to shared storage.
RAGSTRIKE_STORAGE__DATABASE_URL=sqlite+aiosqlite:///./data/scans.db
RAGSTRIKE_STORAGE__REPORTS_DIR=./reports

# ---- Engine ---------------------------------------------------------------------------------------
RAGSTRIKE_ENGINE__MAX_CONCURRENCY=4
RAGSTRIKE_ENGINE__MAX_QPS=2.0                   # Token bucket ceiling.  Cannot be disabled (ADR-017).
RAGSTRIKE_ENGINE__PROBE_TIMEOUT_S=60

# ---- Safety ---------------------------------------------------------------------------------------
# These defaults mean a fresh install can only scan this machine.  Pointing RAGStrike at a remote
# host is meant to be a deliberate act with a paper trail, not a default.
RAGSTRIKE_SAFETY__REQUIRE_AUTHORIZATION=true
RAGSTRIKE_SAFETY__ALLOW_REMOTE_TARGETS=false
RAGSTRIKE_SAFETY__ALLOWED_HOSTS=localhost,127.0.0.1,::1

# ---- Optional LLM judge ---------------------------------------------------------------------------
# Off by default.  A scanner whose verdicts change when someone upgrades a model cannot support
# trend analysis (ADR-006).  Confidence is capped at 0.7 regardless of what is set here.
RAGSTRIKE_ANALYSIS__LLM_JUDGE__ENABLED=false
RAGSTRIKE_ANALYSIS__LLM_JUDGE__BASE_URL=http://localhost:11434
RAGSTRIKE_ANALYSIS__LLM_JUDGE__MODEL=qwen3

# ---- Logging --------------------------------------------------------------------------------------
RAGSTRIKE_LOGGING__LEVEL=INFO                   # DEBUG writes full request/response bodies to
                                                # logs/debug/ -- those contain whatever the target
                                                # leaked.  Never enable it in a shipped config.
RAGSTRIKE_LOGGING__FORMAT=json
RAGSTRIKE_LOGGING__REDACT_SECRETS=true

# ---- API ------------------------------------------------------------------------------------------
RAGSTRIKE_API__HOST=127.0.0.1                   # Loopback by default, deliberately.
RAGSTRIKE_API__PORT=8000
RAGSTRIKE_DASHBOARD__API_BASE_URL=http://127.0.0.1:8000

# ---- Target credentials ---------------------------------------------------------------------------
# If a target needs authentication, put the token here and REFERENCE it from the target YAML.
# Credentials are never stored in the targets table -- only a reference to the variable name.
# RAGSTRIKE_TARGET_TOKEN_MYAPP=
