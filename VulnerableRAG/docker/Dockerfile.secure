# SecureRAG -- PLACEHOLDER (Phase 1)
#
# PURPOSE
#   Image for the hardened profile.
#
# WHY IT IS A SEPARATE IMAGE RATHER THAN A FLAG
#   The two profiles must not be switchable at runtime. A configuration flag could be flipped by
#   accident, and a misconfiguration that silently hardened the vulnerable target would invalidate
#   every scan result with no visible symptom (ADR-009).
#
# FUTURE RESPONSIBILITIES
#   - Identical build to Dockerfile.vulnerable except VRAG_PROFILE=secure
#   - Expose 9001 (API) and 8602 (UI)
#
# NOTE
#   SecureRAG is hardened against the documented threat model. It is a reference for the controls in
#   rag/policy/controls/, not a production-ready application.

FROM python:3.11-slim AS runtime
# Phase 11: identical to the vulnerable image, with VRAG_PROFILE=secure

LABEL org.opencontainers.image.title="SecureRAG" \
      org.opencontainers.image.description="Hardened twin of VulnerableRAG. Local security lab only." \
      org.opencontainers.image.licenses="Apache-2.0"
