# --------------------------------------------------------------------------------------------------
# VulnerableRAG -- environment template
#
# Copy to `.env`. `.env` is gitignored; this file is committed and must never hold a real value.
#
# THE ONLY SECRETS IN THIS LAB ARE SYNTHETIC. The credentials embedded in the vulnerable profile's
# system prompt are high-entropy, canary-tagged, and clearly labelled, precisely so a real credential
# can never be mistaken for one -- and so any leak is detectable with certainty.
# --------------------------------------------------------------------------------------------------

# ---- The safety gate -------------------------------------------------------------------------------
# The application refuses to start without this. It is a deliberate speed bump: if you find it set in
# a shell profile or a Dockerfile, the gate has been defeated. See docs/LAB_SAFETY.md.
RAGSTRIKE_LAB_ACK=0

# ---- Profile ---------------------------------------------------------------------------------------
VRAG_PROFILE=vulnerable            # vulnerable | secure

# ---- Server ----------------------------------------------------------------------------------------
# Loopback only. Do not change this to make remote access convenient.
VRAG_API_HOST=127.0.0.1
VRAG_API_PORT=9000                 # secure profile: 9001
VRAG_UI_PORT=8601                  # secure profile: 8602

# ---- Model -----------------------------------------------------------------------------------------
VRAG_OLLAMA_BASE_URL=http://localhost:11434
VRAG_MODEL=qwen3
VRAG_TEMPERATURE=0.0               # Zero so scans are reproducible. RAGStrike's determinism criterion
                                   # (SC4) assumes a temperature-zero target.

# ---- Retrieval -------------------------------------------------------------------------------------
# IDENTICAL for both profiles. A difference here would make a difference in results look like a
# security control when it is really a tuning artifact.
VRAG_CHUNK_SIZE=512
VRAG_CHUNK_OVERLAP=64
VRAG_TOP_K=5
VRAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Storage ---------------------------------------------------------------------------------------
VRAG_DATABASE_URL=sqlite+aiosqlite:///./data/vulnerable.db
VRAG_CHROMA_DIR=./vectorstore/chroma
VRAG_UPLOAD_DIR=./uploads
